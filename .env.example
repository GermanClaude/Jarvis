# Kopiere diese Datei nach ~/jarvis-data/.env und trage deinen Schlüssel ein.

# ---------------------------------------------------------------- Sprachmodell
# Anbieter: gemini | groq | openrouter | mistral | ollama | anthropic | openai
#   gemini      Google Gemini – kostenlos, empfohlen   Schlüssel: https://aistudio.google.com/apikey
#   groq        Groq – kostenlos, sehr schnell         Schlüssel: https://console.groq.com/keys
#   openrouter  OpenRouter – kostenlose ":free"-Modelle Schlüssel: https://openrouter.ai/keys
#   mistral     Mistral – kostenloser Plan             Schlüssel: https://console.mistral.ai/api-keys
#   ollama      Lokales Modell auf deinem PC – kostenlos, kein Schlüssel
#   anthropic   Claude – kostenpflichtig, beste Qualität (pip install -r requirements-claude.txt)
#   openai      Beliebiger OpenAI-kompatibler Dienst (dann JARVIS_BASE_URL setzen)
# Ohne JARVIS_PROVIDER nimmt Jarvis den Anbieter, dessen Schlüssel unten eingetragen ist.
JARVIS_PROVIDER=gemini

# Nur den Schlüssel deines Anbieters eintragen:
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...

# Modell (leer = Standard des Anbieters). Verfügbare Modelle anzeigen: jarvis models
# JARVIS_MODEL=
# Adresse des Dienstes (nur für ollama auf einem anderen Gerät oder für "openai" nötig)
# JARVIS_BASE_URL=http://192.168.178.20:11434/v1
# Maximale Antwortlänge in Tokens (nicht für Claude)
# JARVIS_MAX_TOKENS=8192

# Nur für Claude: Denktiefe (low | medium | high | xhigh | max)
# JARVIS_EFFORT=high

# ---------------------------------------------------------------- Allgemein
# Wie Jarvis dich nennen soll (optional)
JARVIS_USER_NAME=

# Ordner, in dem Jarvis arbeitet (Standard: dein Home-Ordner)
# JARVIS_WORKSPACE=~
# Weitere erlaubte Ordner, mit : getrennt (Standard: Handyspeicher)
# JARVIS_EXTRA_ROOTS=/storage/emulated/0

# Shell-Befehle erlauben (1/0)
JARVIS_ALLOW_SHELL=1
# Websuche erlauben (1/0) – ohne Claude kostenlos über DuckDuckGo
JARVIS_WEB_TOOLS=1
# Nach wie vielen Nachrichten Jarvis im Hintergrund aus dem Gespräch lernt
# (jedes Lernen ist eine zusätzliche Anfrage – bei knappen Gratis-Limits höher setzen)
JARVIS_REFLECT_EVERY=6

# Netzwerk: 127.0.0.1 = nur dieses Handy. 0.0.0.0 = auch andere Geräte im WLAN
# (dann ist ein Zugangscode Pflicht; wird sonst automatisch erzeugt).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# JARVIS_TOKEN=mein-geheimer-code
